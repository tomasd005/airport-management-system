# Makefile.performance
#
# Uso:
#   make -f Makefile.performance
#   make -f Makefile.performance pgo-generate
#   make -f Makefile.performance pgo-use

CC ?= gcc
PKG_CONFIG ?= pkg-config

CPPFLAGS := -D_GNU_SOURCE \
	-Iinclude \
	-Iinclude/entidades \
	-Iinclude/gestores \
	-Iinclude/gestor_programa \
	-Iinclude/gestor_programas \
	-Iinclude/parsers \
	-Iinclude/queries \
	-Iinclude/validacoes \
	$(shell $(PKG_CONFIG) --cflags glib-2.0)

WARN := -Wall -Wextra -Wpedantic -Wno-unused-parameter
BASE := -std=c11 -DNDEBUG
PERF := -O3 -march=native -mtune=native -flto=auto -fno-plt -fomit-frame-pointer

CFLAGS ?= $(BASE) $(WARN) $(PERF)
LDFLAGS ?= -flto=auto
LDLIBS := $(shell $(PKG_CONFIG) --libs glib-2.0)

OBJDIR := build/perf-obj

SRC_ENTIDADES := src/entidades/aeroportos.c src/entidades/avioes.c src/entidades/passageiros.c src/entidades/reservas.c src/entidades/voos.c
SRC_GESTORES := src/gestores/gestor_aeroportos.c src/gestores/gestor_avioes.c src/gestores/gestor_voos.c src/gestores/gestor_passageiros.c src/gestores/gestor_reservas.c
SRC_GESTOR_PROGRAMA := src/gestor_programa/gestor_programa.c src/gestor_programa/gestor_queries.c
SRC_GESTOR_PROGRAMAS := src/gestor_programas/gestor_principal.c src/gestor_programas/gestor_teste.c src/gestor_programas/gestor_interativo.c
SRC_PARSERS := src/parsers/parser.c src/parsers/parser_reservas.c src/validacoes/validacao_comum.c src/validacoes/validacao_aeroportos.c src/validacoes/validacao_avioes.c src/validacoes/validacao_voos.c src/validacoes/validacao_passageiros.c src/validacoes/validacao_reservas.c
SRC_QUERIES := src/queries/querie1.c src/queries/querie2.c src/queries/querie3.c src/queries/querie4.c src/queries/querie5.c src/queries/querie6.c
SRC_UTILS := src/utils.c src/string_pool.c
SRC_ESTRUTURAS := src/estruturas/voo_table.c src/estruturas/doc_total_table.c src/estruturas/passageiro_table.c

SRC_CORE := $(SRC_ENTIDADES) $(SRC_GESTORES) $(SRC_PARSERS) $(SRC_QUERIES) $(SRC_UTILS) $(SRC_ESTRUTURAS)

OBJ_CORE := $(addprefix $(OBJDIR)/,$(SRC_CORE:.c=.o))
OBJ_GP := $(addprefix $(OBJDIR)/,$(SRC_GESTOR_PROGRAMA:.c=.o))
OBJ_GPS := $(addprefix $(OBJDIR)/,$(SRC_GESTOR_PROGRAMAS:.c=.o))
OBJ_MAIN := $(OBJDIR)/src/programas/main.o
OBJ_TESTE := $(OBJDIR)/src/programas/teste.o

all: programa-principal programa-testes

programa-principal: $(OBJ_MAIN) $(OBJ_GP) $(OBJ_CORE)
	$(CC) $(LDFLAGS) $^ $(LDLIBS) -o $@

programa-testes: $(OBJ_TESTE) $(OBJ_GPS) $(OBJ_CORE)
	$(CC) $(LDFLAGS) $^ $(LDLIBS) -o $@

$(OBJDIR)/%.o: %.c
	@mkdir -p $(dir $@)
	$(CC) $(CPPFLAGS) $(CFLAGS) -MMD -MP -c $< -o $@

pgo-generate:
	$(MAKE) -f Makefile.performance clean
	$(MAKE) -f Makefile.performance CFLAGS="$(BASE) $(WARN) $(PERF) -fprofile-generate" LDFLAGS="$(LDFLAGS) -fprofile-generate"
	LI3_DISABLE_RESULT_CACHE=1 ./programa-principal ./sem_erros_grande inputs_fase2.txt

pgo-use:
	$(MAKE) -f Makefile.performance clean
	$(MAKE) -f Makefile.performance CFLAGS="$(BASE) $(WARN) $(PERF) -fprofile-use -fprofile-correction" LDFLAGS="$(LDFLAGS) -fprofile-use"

clean:
	rm -rf $(OBJDIR) programa-principal programa-testes

-include $(OBJ_CORE:.o=.d) $(OBJ_GP:.o=.d) $(OBJ_GPS:.o=.d) $(OBJ_MAIN:.o=.d) $(OBJ_TESTE:.o=.d)

.PHONY: all clean pgo-generate pgo-use
